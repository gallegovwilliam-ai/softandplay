# Ejemplo Audit 20. Instale el certificado con Certbot y ajuste las rutas.
upstream softandplay_http { server 127.0.0.1:8000; }
upstream softandplay_ws { server 127.0.0.1:9000; }

server {
    listen 80;
    listen [::]:80;
    server_name appsoftandplay.com www.appsoftandplay.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name appsoftandplay.com www.appsoftandplay.com;

    ssl_certificate /etc/letsencrypt/live/appsoftandplay.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/appsoftandplay.com/privkey.pem;
    client_max_body_size 100M;

    location /static/ { alias /opt/softandplay/app/static_files/; expires 30d; }
    location /media/ { alias /opt/softandplay/app/media_files/; expires 30d; }
    location /notifications/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://softandplay_ws;
    }
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120;
        proxy_pass http://softandplay_http;
    }
}
